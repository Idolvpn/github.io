                doubleDesc: 'Two AES-GCM layers with independent keys',
                modeLabel: 'Encryption mode',
                singleMode: 'AES-256-GCM — single layer',
                doubleMode: 'AES-256-GCM — double layer',
                secondPass: 'Second password',
                encryptBtn: '🔒 Encrypt & Hide',
                receiverStep: 'Extract message',
                extractTitle: 'Import an HMM file',
                dropHMM: 'Drop an HMM output file here',
                dropSub2: 'or click to choose a file',
                decryptPass: 'Password',
                decryptBtn: '🔓 Extract & Decrypt',
                resultLabel: 'Extracted message',
                copy: 'Copy message',
                downloadCarrier: 'Download original file',
                s1t: 'Password-derived key',
                s1d: 'The key is derived with PBKDF2, 600,000 SHA-256 iterations, and a random salt.',
                s2t: 'Message integrity',
                s2d: 'AES-GCM provides confidentiality and detects ciphertext tampering.',
                s3t: 'No server',
                s3d: 'In this version, the message and passwords never leave your browser and nothing is uploaded.',
                copyright: '© 2026 HMM Tools — Hide My Messages • Made for the Idolvpn Telegram channel',
                errFile: 'Please choose a carrier file.',
                errMsg: 'The message is empty.',
                errPass: 'Password must be at least 10 characters.',
                errPass2: 'Enter a second password for double-layer mode.',
                working: 'Processing…',
                done: 'Secure file created.',
                bad: 'Wrong password or the file is damaged/tampered with.',
                copied: 'Message copied.',
                notHMM: 'This is not a valid HMM file.'
            }
        };

        function tr(k) { return I[lang][k] || k }

        function applyLang() {
            document.documentElement.lang = lang;
            document.documentElement.dir = lang === 'fa' ? 'rtl' : 'ltr';
            document.querySelectorAll('[data-i18n]').forEach(el => el.textContent = tr(el.dataset.i18n));
            $('langBtn').textContent = lang === 'fa' ? 'EN' : 'FA';
        }
        $('langBtn').onclick = () => { lang = lang === 'fa' ? 'en' : 'fa';
            applyLang() };
        $('themeBtn').onclick = () => { const d = document.documentElement; const dark = d.dataset.theme === 'dark';
            d.dataset.theme = dark ? 'light' : 'dark';
            $('themeBtn').textContent = dark ? '☾' : '☀' };
        if (matchMedia('(prefers-color-scheme: dark)').matches) { document.documentElement.dataset.theme = 'dark';
            $('themeBtn').textContent = '☀' }

        function status(el, msg, type = '') { el.textContent = msg;
            el.className = 'status ' + type }

        function showToast(msg) { const t = $('toast');
            t.textContent = msg;
            t.classList.add('show');
            setTimeout(() => t.classList.remove('show'), 1800) }

        function fmt(n) { return n < 1024 ? `${n} B` : n < 1048576 ? `${(n/1024).toFixed(1)} KB` : `${(n/1048576).toFixed(2)} MB` }

        function setMeta(el, file) { el.style.display = 'block';
            el.textContent = `${file.name} • ${fmt(file.size)} • ${file.type||'application/octet-stream'}` }

        function setupDrop(drop, input, cb) {
            drop.onclick = () => input.click();
            ['dragenter', 'dragover'].forEach(e => drop.addEventListener(e, ev => { ev.preventDefault();
                drop.classList.add('drag') }));
            ['dragleave', 'drop'].forEach(e => drop.addEventListener(e, ev => { ev.preventDefault();
                drop.classList.remove('drag') }));
            drop.addEventListener('drop', ev => { const f = ev.dataTransfer.files[0]; if (f) cb(f) });
            input.onchange = () => { if (input.files[0]) cb(input.files[0]) };
        }
        setupDrop($('sendDrop'), $('sendFile'), f => { if (f.size > MAX_CARRIER_SIZE) { status($('sendStatus'), lang === 'fa' ? 'فایل بیش از ۱ گیگابایت است.' : 'File is larger than 1 GB.', 'err'); return } sendCarrier = f;
            setMeta($('sendMeta'), f);
            $('encryptBtn').disabled = false });
        setupDrop($('receiveDrop'), $('receiveFile'), f => { receiveContainer = f;
            setMeta($('receiveMeta'), f);
            $('decryptBtn').disabled = false });
        $('mode').onchange = () => { $('secondPassWrap').classList.toggle('hidden', $('mode').value !== 'double') };

        document.querySelectorAll('.eye').forEach(b => b.onclick = () => { const i = $(b.dataset.target);
            i.type = i.type === 'password' ? 'text' : 'password' });

        function b64(bytes) { let s = ''; const a = new Uint8Array(bytes); for (let i = 0; i < a.length; i += 0x8000) s += String.fromCharCode(...a.subarray(i, i + 0x8000)); return btoa(s) }

        function unb64(s) { const bin = atob(s),
                a = new Uint8Array(bin.length); for (let i = 0; i < bin.length; i++) a[i] = bin.charCodeAt(i); return a }

        function concat(...arrays) { let n = arrays.reduce((x, a) => x + a.length, 0),
                r = new Uint8Array(n),
                p = 0; for (const a of arrays) { r.set(a, p);
                p += a.length } return r }

        function u64(n) { const a = new Uint8Array(8); const v = BigInt(n); for (let i = 7; i >= 0; i--) { a[i] = Number(v >> BigInt((7 - i) * 8) & 255n) } return a }

        function readU64(a, o) { let n = 0n; for (let i = 0; i < 8; i++) n = (n << 8n) | BigInt(a[o + i]); return Number(n) }

        async function derive(password, salt) {
            const base = await crypto.subtle.importKey('raw', te.encode(password), 'PBKDF2', false, ['deriveKey']);
            return crypto.subtle.deriveKey({ name: 'PBKDF2', salt, iterations: 600000, hash: 'SHA-256' }, base, { name: 'AES-GCM', length: 256 }, false, ['encrypt', 'decrypt']);
        }

        async function encryptLayer(data, password) {
            const salt = crypto.getRandomValues(new Uint8Array(16)),
                iv = crypto.getRandomValues(new Uint8Array(12));
            const key = await derive(password, salt);
            const ct = new Uint8Array(await crypto.subtle.encrypt({ name: 'AES-GCM', iv, tagLength: 128 }, key, data));
            return { salt: b64(salt), iv: b64(iv), ct: b64(ct) };
        }

        async function decryptLayer(obj, password) {
            const key = await derive(password, unb64(obj.salt));
            return new Uint8Array(await crypto.subtle.decrypt({ name: 'AES-GCM', iv: unb64(obj.iv), tagLength: 128 }, key, unb64(obj.ct)));
        }

        function findTrailer(bytes) {
            const m = MAGIC;
            const min = m.length + 8;
            if (bytes.length < min) return null;
            for (let i = bytes.length - min; i >= 0; i--) {
                let ok = true;
                for (let j = 0; j < m.length; j++)
                    if (bytes[i + j] !== m[j]) { ok = false; break }
                if (ok) { const len = readU64(bytes, i + m.length); const start = i + m.length + 8; if (start + len === bytes.length) return { pos: i, payload: bytes.slice(start) } }
            }
            return null;
        }

        function downloadBlob(blob, name) {
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = name;
            a.click();
            setTimeout(() => URL.revokeObjectURL(a.href), 1000);
        }

        $('encryptBtn').onclick = async () => {
            const st = $('sendStatus');
            status(st, tr('working'));
            if (!sendCarrier) { status(st, tr('errFile'), 'err'); return }
            const msg = $('message').value;
            const p1 = $('password').value;
            if (!msg.trim()) { status(st, tr('errMsg'), 'err'); return }
            if (p1.length < 10) { status(st, tr('errPass'), 'err'); return }
            const double = $('mode').value === 'double',
                p2 = $('password2').value;
            if (double && p2.length < 10) { status(st, tr('errPass2'), 'err'); return }
            $('encryptBtn').disabled = true;
            try {
                const plain = te.encode(msg);
                let layers = [await encryptLayer(plain, p1)];
                if (double) layers.push(await encryptLayer(unb64(layers[0].ct), p2));
                const meta = { v: 1, app: 'HMM Tools', mode: double ? 'double' : 'single', carrierName: sendCarrier.name, carrierType: sendCarrier.type || '', messageLayers: layers };
                const payload = te.encode(JSON.stringify(meta));
                const carrier = new Uint8Array(await sendCarrier.arrayBuffer());
                const out = concat(carrier, MAGIC, u64(payload.length), payload);
                const ext = sendCarrier.name.includes('.') ? sendCarrier.name.slice(sendCarrier.name.lastIndexOf('.')) : '';
                downloadBlob(new Blob([out], { type: sendCarrier.type || 'application/octet-stream' }), `HMM_${Date.now()}${ext}`);
                status(st, tr('done'), 'ok');
            } catch (e) { console.error(e);
                status(st, e.message || String(e), 'err') } finally { $('encryptBtn').disabled = false }
        };

        $('decryptBtn').onclick = async () => {
            const st = $('receiveStatus');
            status(st, tr('working'));
            if (!receiveContainer) { status(st, tr('errFile'), 'err'); return }
            $('decryptBtn').disabled = true;
            try {
                const bytes = new Uint8Array(await receiveContainer.arrayBuffer()),
                    found = findTrailer(bytes);
                if (!found) throw new Error(tr('notHMM'));
                const meta = JSON.parse(td.decode(found.payload));
                const p1 = $('decryptPassword').value;
                let inner;
                if (meta.mode === 'double') {
                    $('decryptPass2Wrap').classList.remove('hidden');
                    const p2 = $('decryptPassword2').value;
                    if (!p2) { status(st, tr('secondPass'), 'err');
                        $('decryptBtn').disabled = false; return }
                    // Layer 2 decrypts to Layer 1 ciphertext; then Layer 1 decrypts to the message.
                    const firstCiphertext = await decryptLayer(meta.messageLayers[1], p2);
                    const key = await derive(p1, unb64(meta.messageLayers[0].salt));
                    inner = new Uint8Array(await crypto.subtle.decrypt({ name: 'AES-GCM', iv: unb64(meta.messageLayers[0].iv), tagLength: 128 }, key, firstCiphertext));
                } else {
                    inner = await decryptLayer(meta.messageLayers[0], p1);
                }
                $('resultText').value = td.decode(inner);
                $('result').classList.remove('hidden');
                status(st, tr('done'), 'ok');
                $('downloadCarrierBtn').onclick = () => {
                    const original = bytes.slice(0, found.pos);
                    downloadBlob(new Blob([original], { type: meta.carrierType || 'application/octet-stream' }), meta.carrierName || 'original-file');
                };
            } catch (e) { console.error(e);
                $('result').classList.add('hidden');
                status(st, tr('bad'), 'err') } finally { $('decryptBtn').disabled = false }
        };

        $('copyBtn').onclick = async () => { await navigator.clipboard.writeText($('resultText').value);
            showToast(tr('copied')) };
        applyLang();
    </script>
</body>
</html>
